graph ER {
  layout=neato; overlap=true; splines=false; outputorder=edgesfirst;
  bgcolor=white; pad=0.4; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white];
  edge [fontname="Helvetica", fontsize=12, len=1.1];
  USERS [shape=box, penwidth=2, fontsize=14, label=<<B>USERS</B>>, pos="0,0!"];
  PROJECT [shape=box, penwidth=2, fontsize=14, label=<<B>PROJECT</B>>, pos="15,0!"];
  APPLICATION [shape=box, penwidth=2, fontsize=14, label=<<B>APPLICATION</B>>, pos="7.5,7!"];
  SKILL [shape=box, penwidth=2, fontsize=14, label=<<B>SKILL</B>>, pos="7.5,-6.5!"];
  TEAM [shape=box, penwidth=2, fontsize=14, label=<<B>TEAM</B>>, pos="7.5,14!"];
  TASK [shape=box, penwidth=2, fontsize=14, label=<<B>TASK</B>>, pos="7.5,-14!"];
  SUBMITS [shape=diamond, fillcolor="#eef2ff", label="SUBMITS", pos="2.6,4.2!"];
  SUBMITS -- USERS [label="1"];
  SUBMITS -- APPLICATION [label="N", color="black:white:black", penwidth=1.2];
  REVIEWS [shape=diamond, fillcolor="#eef2ff", label="REVIEWS", pos="5.0,2.2!"];
  REVIEWS -- USERS [label="owner 1"];
  REVIEWS -- APPLICATION [label="N"];
  a1 [shape=ellipse, label="decision_date", pos="3.61,3.00!"];
  REVIEWS -- a1;
  RECEIVES [shape=diamond, fillcolor="#eef2ff", label="RECEIVES", pos="11.8,3.8!"];
  RECEIVES -- PROJECT [label="1"];
  RECEIVES -- APPLICATION [label="N", color="black:white:black", penwidth=1.2];
  CREATES_OWNS [shape=diamond, fillcolor="#eef2ff", label="CREATES / OWNS", pos="10.2,0.6!"];
  CREATES_OWNS -- USERS [label="1"];
  CREATES_OWNS -- PROJECT [label="N", color="black:white:black", penwidth=1.2];
  TRANSFERS [shape=diamond, fillcolor="#eef2ff", label="TRANSFERS", pos="9.4,-2.2!"];
  TRANSFERS -- PROJECT [label="N"];
  TRANSFERS -- USERS:e [headlabel="from 1", labeldistance=3.5, labelangle=25];
  TRANSFERS -- USERS:s [headlabel="to 1", labeldistance=3.5, labelangle=-30];
  a2 [shape=ellipse, label="transferred_at", pos="9.40,-3.50!"];
  TRANSFERS -- a2;
  HAS [shape=diamond, fillcolor="#eef2ff", label="HAS", pos="2.6,-3.6!"];
  HAS -- USERS [label="M"];
  HAS -- SKILL [label="N"];
  a3 [shape=ellipse, label="u_s_level", pos="1.13,-4.63!"];
  HAS -- a3;
  REQUIRES [shape=diamond, fillcolor="#eef2ff", label="REQUIRES", pos="12.4,-3.6!"];
  REQUIRES -- PROJECT [label="M"];
  REQUIRES -- SKILL [label="N"];
  a4 [shape=ellipse, label="p_s_level", pos="12.97,-5.73!"];
  REQUIRES -- a4;
  a5 [shape=ellipse, label="req_role", pos="14.20,-4.86!"];
  REQUIRES -- a5;
  a6 [shape=ellipse, label="req_count", pos="14.59,-3.41!"];
  REQUIRES -- a6;
  JOINS [shape=diamond, fillcolor="#eef2ff", label="JOINS", pos="0,10.5!"];
  JOINS -- USERS [label="M"];
  JOINS -- TEAM [label="N", color="black:white:black", penwidth=1.2];
  a7 [shape=ellipse, label="role", pos="-0.89,12.40!"];
  JOINS -- a7;
  a8 [shape=ellipse, label="join_date", pos="-2.10,10.50!"];
  JOINS -- a8;
  a9 [shape=ellipse, label="leave_date", color="#b45309", fontcolor="#b45309", pos="-0.89,8.60!"];
  JOINS -- a9;
  HAS_TEAM [shape=diamond, fillcolor="#eef2ff", label="HAS", pos="15,10.5!"];
  HAS_TEAM -- PROJECT [label="1", color="black:white:black", penwidth=1.2];
  HAS_TEAM -- TEAM [label="1", color="black:white:black", penwidth=1.2];
  ASSIGNED_TO [shape=diamond, fillcolor="#eef2ff", label="ASSIGNED TO", pos="0,-10.5!"];
  ASSIGNED_TO -- USERS [label="1"];
  ASSIGNED_TO -- TASK [label="N"];
  CONTAINS [shape=diamond, fillcolor="#eef2ff", label="CONTAINS", pos="15,-10.5!"];
  CONTAINS -- PROJECT [label="1"];
  CONTAINS -- TASK [label="N", color="black:white:black", penwidth=1.2];
  SUBTASK_OF [shape=diamond, fillcolor="#eef2ff", label="SUBTASK OF", pos="7.5,-18.5!"];
  SUBTASK_OF -- TASK:sw [headlabel="parent 1", labeldistance=3.5, labelangle=25];
  SUBTASK_OF -- TASK:se [headlabel="subtask N", labeldistance=3.5, labelangle=25];
  a10 [shape=ellipse, label=<<U>id</U>>, pos="-0.80,2.47!"];
  USERS -- a10;
  a11 [shape=ellipse, label="name", pos="-1.94,3.50!"];
  USERS -- a11;
  a12 [shape=ellipse, label="f_name", pos="-1.31,5.29!"];
  a11 -- a12;
  a13 [shape=ellipse, label="m_name", pos="-2.87,5.16!"];
  a11 -- a13;
  a14 [shape=ellipse, label="l_name", pos="-3.80,3.90!"];
  a11 -- a14;
  a15 [shape=ellipse, label="email", pos="-1.68,1.99!"];
  USERS -- a15;
  a16 [shape=ellipse, label="password_hash", pos="-3.12,2.50!"];
  USERS -- a16;
  a17 [shape=ellipse, label="role", color="#b45309", fontcolor="#b45309", pos="-2.30,1.21!"];
  USERS -- a17;
  a18 [shape=ellipse, label="bio", pos="-3.83,1.14!"];
  USERS -- a18;
  a19 [shape=ellipse, label="location", pos="-2.59,0.25!"];
  USERS -- a19;
  a20 [shape=ellipse, label="u_photo", pos="-3.98,-0.39!"];
  USERS -- a20;
  a21 [shape=ellipse, label="dob", pos="-2.49,-0.74!"];
  USERS -- a21;
  a22 [shape=ellipse, style="filled,dashed", label="age", pos="-3.54,-1.86!"];
  USERS -- a22;
  a23 [shape=ellipse, label="experience_level", pos="-2.03,-1.63!"];
  USERS -- a23;
  a24 [shape=ellipse, label="availability", pos="-2.58,-3.06!"];
  USERS -- a24;
  a25 [shape=ellipse, label="is_active", color="#b45309", fontcolor="#b45309", pos="-1.26,-2.27!"];
  USERS -- a25;
  a26 [shape=ellipse, label="created_at", pos="-1.24,-3.80!"];
  USERS -- a26;
  a27 [shape=ellipse, label=<<U>p_id</U>>, pos="16.49,-2.13!"];
  PROJECT -- a27;
  a28 [shape=ellipse, label="p_name", pos="18.14,-2.32!"];
  PROJECT -- a28;
  a29 [shape=ellipse, label="description", pos="17.47,-0.80!"];
  PROJECT -- a29;
  a30 [shape=ellipse, label="deadline", pos="18.90,0.05!"];
  PROJECT -- a30;
  a31 [shape=ellipse, label="status", pos="17.45,0.86!"];
  PROJECT -- a31;
  a32 [shape=ellipse, label="max_team_size", color="#b45309", fontcolor="#b45309", pos="18.08,2.39!"];
  PROJECT -- a32;
  a33 [shape=ellipse, label="creation_date", pos="16.44,2.17!"];
  PROJECT -- a33;
  a34 [shape=ellipse, peripheries=2, label="domain", pos="16.01,3.77!"];
  PROJECT -- a34;
  a35 [shape=ellipse, label=<<U>s_id</U>>, pos="5.71,-7.15!"];
  SKILL -- a35;
  a36 [shape=ellipse, label="s_name", pos="7.50,-8.40!"];
  SKILL -- a36;
  a37 [shape=ellipse, label="category", pos="9.29,-7.15!"];
  SKILL -- a37;
  a38 [shape=ellipse, label=<<U>a_id</U>>, pos="9.14,8.15!"];
  APPLICATION -- a38;
  a39 [shape=ellipse, label="msg", pos="8.13,8.90!"];
  APPLICATION -- a39;
  a40 [shape=ellipse, label="status\n(+ Withdrawn)", color="#b45309", fontcolor="#b45309", pos="6.87,8.90!"];
  APPLICATION -- a40;
  a41 [shape=ellipse, label="a_date", pos="5.86,8.15!"];
  APPLICATION -- a41;
  a42 [shape=ellipse, label=<<U>t_id</U>>, pos="8.96,15.22!"];
  TEAM -- a42;
  a43 [shape=ellipse, label="team_name", pos="7.50,15.90!"];
  TEAM -- a43;
  a44 [shape=ellipse, label="create_date", pos="6.04,15.22!"];
  TEAM -- a44;
  a45 [shape=ellipse, label=<<U>task_id</U>>, pos="9.63,-13.43!"];
  TASK -- a45;
  a46 [shape=ellipse, label="t_name", pos="9.95,-11.94!"];
  TASK -- a46;
  a47 [shape=ellipse, label="description", pos="8.43,-12.01!"];
  TASK -- a47;
  a48 [shape=ellipse, label="status", pos="7.50,-10.80!"];
  TASK -- a48;
  a49 [shape=ellipse, label="priority", pos="6.57,-12.01!"];
  TASK -- a49;
  a50 [shape=ellipse, label="due_date", pos="5.05,-11.94!"];
  TASK -- a50;
  a51 [shape=ellipse, label="created_at", pos="5.37,-13.43!"];
  TASK -- a51;
  legend [shape=plaintext, pos="-6,-18!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" BGCOLOR="white"><TR><TD COLSPAN="2"><B>TeamTREE ER (schema v2, Chen notation)</B></TD></TR><TR><TD ALIGN="LEFT">Rectangle</TD><TD ALIGN="LEFT">entity</TD></TR><TR><TD ALIGN="LEFT">Diamond</TD><TD ALIGN="LEFT">relationship</TD></TR><TR><TD ALIGN="LEFT"><U>underlined</U></TD><TD ALIGN="LEFT">key attribute</TD></TR><TR><TD ALIGN="LEFT">double ellipse</TD><TD ALIGN="LEFT">multivalued (domain)</TD></TR><TR><TD ALIGN="LEFT">dashed ellipse</TD><TD ALIGN="LEFT">derived (age from dob)</TD></TR><TR><TD ALIGN="LEFT">ellipse with sub-ellipses</TD><TD ALIGN="LEFT">composite (name)</TD></TR><TR><TD ALIGN="LEFT">double line</TD><TD ALIGN="LEFT">total participation</TD></TR><TR><TD ALIGN="LEFT">single line</TD><TD ALIGN="LEFT">partial participation</TD></TR><TR><TD ALIGN="LEFT">1 / N / M</TD><TD ALIGN="LEFT">cardinality</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#b45309">orange</FONT></TD><TD ALIGN="LEFT">new in v2</TD></TR></TABLE>>];
}
