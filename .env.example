# Copy to .env and change the passwords. Read by docker-compose, api/scripts and the API.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-root-pw
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=teamtree
# low-privilege app user (role tt_member_app)
TT_APP_PASSWORD=change-app-pw
# read-only analytics user (role tt_analyst)
TT_REPORT_PASSWORD=change-report-pw

# --- Neo4j (password must be at least 8 characters) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-neo4j-pw

# --- Auth (web/.env.local must use the same JWT_SECRET) ---
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_MINUTES=720

# --- Web ---
WEB_ORIGIN=http://localhost:3000

# development enables the admin seed-reset button; set to production to disable it
APP_ENV=development
